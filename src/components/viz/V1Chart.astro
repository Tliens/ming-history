---
// V1 权力结构组织图（四期切换：洪武/永宣/正德/万历）· 数据 offices.json
import offices from "../../data/offices.json";
const periods = offices.periods.map((p) => ({ id: p.id, label: p.label }));
---
<div id="v1btns" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px" role="tablist" aria-label="时期切换">
  {periods.map((p, i) => (
    <button class="btn btn-pill" data-period={p.id} aria-pressed={i === periods.length - 1}>{p.label}</button>
  ))}
</div>
<div style="display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px" class="v1-wrap">
  <div id="v1chart" style="height:620px;border:1px solid var(--c-line);border-radius:8px" aria-label="权力结构组织图" class="chart-wrap"><div class="chart-skel"></div></div>
  <aside class="card" id="v1panel" style="font-size:13px;align-self:start">
    <h3 id="v1p-title" style="margin:0 0 6px;font-size:15px"></h3>
    <p id="v1p-base" style="color:var(--c-ink-2);margin:0 0 8px"></p>
    <ul id="v1p-diffs" style="margin:0;padding-left:1.2em;line-height:1.7"></ul>
    <p id="v1node" style="margin-top:10px;border-top:1px dashed var(--c-line);padding-top:8px;color:var(--c-ink-2)"></p>
  </aside>
</div>
<script>
  import * as echarts from "echarts";
  import { chartTheme, onThemeChange } from "../../lib/echarts-theme.js";
  import offices from "../../data/offices.json";

  const NODES = Object.fromEntries(offices.nodes.map((n) => [n.id, n]));
  const childrenOf = (id) => offices.nodes.filter((n) => n.parent === id);
  const toTree = (id) => {
    const n = NODES[id];
    return { name: n.name, id: n.id, value: n.type, itemStyle: {}, children: childrenOf(id).map((c) => toTree(c.id)) };
  };
  const el = document.getElementById("v1chart");
  let chart = echarts.init(el, chartTheme());
  let curPeriod = "wanli";

  function setPeriod(pid) {
    curPeriod = pid;
    const period = offices.periods.find((p) => p.id === pid);
    const t = chartTheme();
    const diffMap = {};
    for (const d of period.diffs) diffMap[d.nodeId] = d;
    const tree = toTree("emperor");
    (function paint(node) {
      const d = diffMap[node.id];
      if (d) {
        if (d.status === "无") { node.itemStyle = { color: "#B8AE9A", borderColor: "#B8AE9A" }; node.lineStyle = { opacity: 0.35 }; node.label = { color: "#8A8272" }; }
        else if (d.status.includes("新") || d.status.includes("复") || d.status.includes("出现") || d.status.includes("外派")) { node.itemStyle = { color: "#A02C2C", borderColor: "#7A1F1F" }; node.label = { fontWeight: 700 }; }
        else node.itemStyle = { color: "#C6A664", borderColor: "#8A6D3B" };
      }
      node.children?.forEach(paint);
    })(tree);
    chart.setOption({
      series: [{
        type: "tree", data: [tree], orient: "TB", roam: true, top: "4%", bottom: "8%", left: "4%", right: "4%",
        symbol: "circle", symbolSize: 13, expandAndCollapse: true, initialTreeDepth: 2,
        label: { position: "bottom", rotate: 40, fontSize: 11, color: t.ink },
        leaves: { label: { rotate: 40 } },
        lineStyle: { color: t.axis, width: 1 },
        emphasis: { focus: "ancestor" },
      }],
    });
    document.getElementById("v1p-title").textContent = period.label;
    document.getElementById("v1p-base").textContent = "基准： " + period.base;
    document.getElementById("v1p-diffs").innerHTML = period.diffs
      .map((d) => `<li><b>${NODES[d.nodeId].name}</b>［${d.status}］—— ${d.note}</li>`).join("");
    document.querySelectorAll("#v1btns .btn-pill").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.period === pid)));
  }

  chart.on("click", (p) => {
    const n = NODES[p.data?.id];
    if (n) document.getElementById("v1node").innerHTML = `<b>${n.name}</b>${n.rank ? "（" + n.rank + "）" : ""}<br/>${n.summary}${n.est ? `<br/><span style="color:#8A6D3B">设立：${n.est}</span>` : ""}`;
  });
  document.querySelectorAll("#v1btns .btn-pill").forEach((b) => b.addEventListener("click", () => setPeriod(b.dataset.period)));
  setPeriod("wanli");
  el.querySelector('.chart-skel')?.remove();
  onThemeChange(() => { chart.dispose(); chart = echarts.init(el, chartTheme()); setPeriod(curPeriod); });
  window.addEventListener("resize", () => chart.resize());
</script>
<style>@media (max-width: 900px) { .v1-wrap { grid-template-columns: 1fr !important; } }</style>
