---
import { ERAS } from "../lib/data.js";
const { current = null, mode = "locate" } = Astro.props;
// mode: locate = 详情页定位（current 为年号名）；filter = 列表页筛选（current 为 emperor id）
---
<div class="era-strip" role="navigation" aria-label="十六朝时间锚">
  {ERAS.map((e) => (
    <a
      href={mode === "filter" ? `?era=${e.emperor}` : `/emperors/${e.emperor}`}
      class={current && (mode === "filter" ? e.emperor === current : e.name === current) ? "cur" : ""}
      style={`background:${e.color};flex-grow:${Math.max(e.end - e.start + 1, 3)}`}
      title={`${e.name}（${e.start}–${e.end}）`}
    >{e.name}</a>
  ))}
</div>
