---
// T6 工具页：年号↔公元双向换算器
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout title="年号换算器 · 创作者" crumbs={[["/", "首页"], ["/creators", "创作者"], ["", "年号换算器"]]}>
  <div class="wrap" style="max-width:680px">
    <div class="page-head">
      <h1>年号换算器</h1>
      <p class="lede">双向换算 + 干支年。数据覆盖明代 17 个年号（含泰昌特例）。</p>
    </div>

    <div class="card" style="margin:20px 0">
      <h3 style="margin:0 0 8px;font-size:15px">公元 → 年号</h3>
      <div style="display:flex;gap:8px;align-items:center">
        <input id="inYear" type="number" min="1368" max="1644" value="1584" style="width:110px;padding:8px;border:1px solid rgba(138,109,59,.4);border-radius:6px;font-size:15px" />
        <button id="btnY" class="btn" style="border:1px solid var(--c-vermilion);color:var(--c-vermilion);background:none;border-radius:6px;padding:8px 14px;cursor:pointer">换算</button>
        <output id="outY" style="font-family:var(--font-display);font-size:18px"></output>
      </div>
    </div>

    <div class="card" style="margin:20px 0">
      <h3 style="margin:0 0 8px;font-size:15px">年号 + 年数 → 公元</h3>
      <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap">
        <select id="selEra" style="padding:8px;border:1px solid rgba(138,109,59,.4);border-radius:6px;font-size:15px"></select>
        <input id="inNum" type="number" min="1" max="60" value="12" style="width:90px;padding:8px;border:1px solid rgba(138,109,59,.4);border-radius:6px;font-size:15px" />
        <span style="font-size:14px">年</span>
        <button id="btnE" class="btn" style="border:1px solid var(--c-vermilion);color:var(--c-vermilion);background:none;border-radius:6px;padding:8px 14px;cursor:pointer">换算</button>
        <output id="outE" style="font-family:var(--font-display);font-size:18px"></output>
      </div>
    </div>

    <p style="font-size:13px;color:var(--c-ink-2)" id="ganzhi"></p>
    <aside class="mh-myth">
      <h4>⚠ 换算特例</h4>
      万历四十八年（1620）七月后已是泰昌元年；同年再改天启（熹宗实际 1621 年改元）——一年三帝两改元，写 1620 年的小说请查月份。①
    </aside>
  </div>
</BaseLayout>

<script>
  const ERAS = [["洪武",1368,1398],["建文",1399,1402],["永乐",1403,1424],["洪熙",1425,1425],["宣德",1426,1435],["正统",1436,1449],["景泰",1450,1457],["天顺",1457,1464],["成化",1465,1487],["弘治",1488,1505],["正德",1506,1521],["嘉靖",1522,1566],["隆庆",1567,1572],["万历",1573,1620],["泰昌",1620,1620],["天启",1621,1627],["崇祯",1628,1644]];
  const GZ = "甲乙丙丁戊己庚辛壬癸", DZ = "子丑寅卯辰巳午未申酉戌亥";
  const ganzhi = (y) => GZ[(y - 4) % 10] + DZ[(y - 4) % 12];
  const sel = document.getElementById("selEra");
  ERAS.forEach((e) => { const o = document.createElement("option"); o.value = e[0]; o.textContent = e[0] + `（${e[1]}–${e[2]}）`; sel.appendChild(o); });
  const y2e = () => {
    const y = +document.getElementById("inYear").value;
    const hit = ERAS.find((e) => y >= e[1] && y <= e[2]);
    document.getElementById("outY").textContent = hit ? `${hit[0]}${y - hit[1] + 1}年（${ganzhi(y)}年）` : "超出 1368–1644";
  };
  const e2y = () => {
    const name = sel.value, n = +document.getElementById("inNum").value;
    const hit = ERAS.find((e) => e[0] === name);
    const y = hit[1] + n - 1;
    document.getElementById("outE").textContent = y <= hit[2] ? `公元 ${y} 年（${ganzhi(y)}年）` : `超出${name}年号（${hit[1]}–${hit[2]}）`;
  };
  document.getElementById("btnY").onclick = y2e;
  document.getElementById("btnE").onclick = e2y;
  y2e(); e2y();
</script>
