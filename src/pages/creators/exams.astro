---
// V17 科举晋升路径（CSS 流程图，移动端友好）
import BaseLayout from "../../layouts/BaseLayout.astro";
import { EXAM_STEPS, EXAM_FACTS } from "../../data/creators.js";
---
<BaseLayout title="科举之路（V17）· 创作者" crumbs={[["/", "首页"], ["/creators", "创作者"], ["", "科举之路"]]}>
  <div class="wrap prose">
    <div class="page-head">
      <h1>科举之路</h1>
      <p class="lede">一个读书人从童生到状元的完整流程与真实录取率。明代 276 年只产生了约 2.4 万名进士——比今天一年清北录取的人还少。</p>
    </div>

    <div class="exam-flow">
      {EXAM_STEPS.map((s, i) => (
        <div class="exam-node">
          <div class="exam-head">
            <span class="exam-stage">{s.stage}</span>
            {i < EXAM_STEPS.length - 1 && <span class="exam-arrow">↓</span>}
          </div>
          <p style="margin:6px 0 2px;font-size:14px">{s.how}</p>
          <div style="font-size:12px;color:var(--c-qinghua)">规模/率：{s.rate}</div>
          <div style="font-size:12px;color:var(--c-ink-2);margin-top:2px">{s.note}</div>
        </div>
      ))}
    </div>

    <section style="margin-top:28px">
      <h2 style="font-size:19px">写科举戏要知道的事实</h2>
      <ul style="font-size:14px">
        {EXAM_FACTS.map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <aside class="mh-myth">
      <h4>⚠ 常见误传</h4>
      「连中三元」明代仅商辂一人（正统十年会试记载有微异，通行说法为乡试解元、会试会元、殿试状元）；别让你的主角轻易三元及第。①③
    </aside>

    <p style="font-size:12px;color:var(--c-ink-2)">依据：《明史·选举志》①、郭培贵《明史选举志考论》③。</p>
  </div>
</BaseLayout>
<style>
.exam-flow { display: flex; flex-direction: column; gap: 0; max-width: 620px; }
.exam-node { border: 1px solid rgba(138,109,59,.3); border-left: 3px solid var(--c-zhehuang); border-radius: 8px; padding: 12px 16px; background: rgba(198,166,100,.06); }
.exam-head { display: flex; align-items: center; justify-content: space-between; }
.exam-stage { font-family: var(--font-display); font-size: 17px; font-weight: 700; }
.exam-arrow { color: var(--c-vermilion); font-size: 18px; margin-right: 4px; }
</style>
