---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TITLES, RANK_RULES } from "../../data/creators.js";
---
<BaseLayout title="称谓指南 · 创作者" crumbs={[["/", "首页"], ["/creators", "创作者"], ["", "称谓指南"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>称谓指南</h1>
      <p class="lede">十二个高频场景的「怎么叫」。总原则：明代口语比影视剧朴素得多，称字不称名、职衔代替尊称。</p>
    </div>
    <table class="data" style="max-width:860px">
      <tr><th style="width:130px">场景</th><th style="width:280px">怎么说</th><th>细节与雷区</th></tr>
      {TITLES.map((t) => (
        <tr><td><strong>{t.scene}</strong></td><td style="font-size:13px">{t.say}</td><td style="font-size:13px;color:var(--c-ink-2)">{t.detail}</td></tr>
      ))}
    </table>
    <aside class="mh-myth" style="margin-top:20px">
      <h4>⚠ 一票否决的三个硬伤</h4>
      官员互称「大人」（明代指父亲）· 宦官自称「奴才」（应为「奴婢」）· 后宫满口「本宫」（戏曲口吻）。
    </aside>
    <p style="font-size:12px;color:var(--c-ink-2)">依据：沈德符《万历野获编》②、陈宝良《明代社会生活史》③、《明会典》①。{RANK_RULES[3]}</p>
  </div>
</BaseLayout>
