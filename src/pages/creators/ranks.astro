---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { RANKS, RANK_RULES } from "../../data/creators.js";
---
<BaseLayout title="九品十八级速查 · 创作者" crumbs={[["/", "首页"], ["/creators", "创作者"], ["", "官品速查"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>九品十八级 · 文官速查</h1>
      <p class="lede">从正一品到未入流：每级列代表性官职。写官场戏先查这张表定「谁大」。</p>
    </div>
    <table class="data" style="max-width:860px">
      <tr><th style="width:90px">品级</th><th>代表官职</th><th style="width:200px">备注</th></tr>
      {RANKS.map((r) => (
        <tr><td><strong>{r.p}</strong></td><td style="font-size:13px">{r.w}</td><td style="font-size:12px;color:var(--c-ink-2)">{r.note}</td></tr>
      ))}
    </table>
    <section style="margin-top:24px;max-width:760px">
      <h2 style="font-size:19px">明代特色：品级 ≠ 权力</h2>
      <ul style="font-size:14px">
        {RANK_RULES.map((r) => <li>{r}</li>)}
      </ul>
    </section>
  </div>
</BaseLayout>
