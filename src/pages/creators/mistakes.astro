---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourceBadge from "../../components/SourceBadge.astro";
import { MISTAKES } from "../../data/creators.js";
import { events } from "../../lib/data.js";
const eventMyths = events.events.filter((e) => e.misconceptions?.length).flatMap((e) => e.misconceptions.map((m) => ({ t: e.title, fix: m, src: "①③" })));
---
<BaseLayout title="误区清单 · 创作者" crumbs={[["/", "首页"], ["/creators", "创作者"], ["", "误区清单"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>影视误区清单（{MISTAKES.length + eventMyths.length} 条）</h1>
      <p class="lede">历史剧与网文的常见硬伤逐条辨析。每条给「正确写法」与史料依据。</p>
    </div>
    <div style="display:grid;gap:10px;margin-top:18px">
      {MISTAKES.map((m) => (
        <div class="card" style="padding:12px 16px">
          <strong style="color:var(--c-vermilion)">✗ {m.t}</strong>
          <span style="float:right"><SourceBadge level={parseInt(m.src) || 3} /></span>
          <div style="font-size:14px;margin-top:4px">✓ {m.fix}</div>
        </div>
      ))}
      {eventMyths.map((m) => (
        <div class="card" style="padding:12px 16px">
          <strong style="color:var(--c-vermilion)">✗ {m.t}</strong>
          <div style="font-size:14px;margin-top:4px">✓ {m.fix}</div>
        </div>
      ))}
    </div>
    <p style="font-size:12px;color:var(--c-ink-2);margin-top:12px">事件类误区（土木堡兵力、倭寇构成、袁崇焕反间计等）随 events.json 同步更新。</p>
  </div>
</BaseLayout>
