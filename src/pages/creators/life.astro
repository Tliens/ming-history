---
import BaseLayout from "../../layouts/BaseLayout.astro";
const SECTIONS = [
  {
    h: "服饰：穿什么就是什么人", items: [
      ["补子（官阶可读图）", "文官胸背织禽：一品仙鹤、二品锦鸡、三品孔雀、四品云雁、五品白鹇、六品鹭鸶、七品鸂鶒、八品黄鹂、九品鹌鹑；武官织兽（一二品狮子、三品虎、四品豹、五品熊罴、六七品彪、八九品犀牛海马）。写官场戏认补子如认军衔。", "①"],
      ["赐服与僭越", "飞鱼服、斗牛服、蟒服皆为「赐服」——赏你才能穿；麒麟服为勋贵。庶民不许用金绣锦绮纻丝绫罗，只许绸绢素纱；商贾阶层限制更严。让小贩穿绸是好素材（违法），让锦衣卫人人飞鱼服是硬伤。", "①③"],
      ["网巾", "成年男子人人束网巾（束发之网，约口「一统山河」）——明代最易被忽略的全民服饰标志，影视剧常缺。取网巾意涵可写遗民「画网巾」故事（清初遗民拒剃发，以笔画网巾）。", "②③"],
      ["日常男装", "士人直裰、道袍；平民短褐、直身；乌纱帽为官员定制。女性袄裙、比甲（无袖长背心）；裙以马面裙为主流。", "③"],
    ],
  },
  {
    h: "饮食：舌尖上的年代感", items: [
      ["主粮地图", "北粟麦、南稻为主食。玉米、番薯、花生均为美洲作物，明中后期传入但清代中叶才真正普及——写嘉靖朝北方农民大口啃玉米棒子就是穿越。辣椒同此（观赏称番椒，吃辣更晚）。", "①③"],
      ["肉食", "猪肉为大众肉（武宗正德曾禁养猪，旋解——可用的荒诞素材）；耕牛受法律保护不许私宰；羊肉偏官贵；鸡鸭常见。", "①③"],
      ["酒茶", "黄酒米酒是主流，「烧刀子」类蒸馏酒明中后期才在北方渐兴；饮茶由煎点转向瀹泡（撮泡法）在明代完成——紫砂壶兴起即为此配套。", "③"],
      ["语感素材", "市井饮食描写可直接读《金瓶梅》（宋蕙莲一根柴火烧猪头）与《三言二拍》——那是明代人自己写的食谱级文本。", "②"],
    ],
  },
  {
    h: "宅院：住处的等级", items: [
      ["间架定制", "《大明律》式规定：庶民庐舍不过三间五架，不许用斗拱、彩色雕饰；一品官屋舍亦可数得出间架限制。越制住大屋是实打实的罪名——「僭越」是现成的冲突引信。", "①"],
      ["格局", "北方四合院（北京为主）、南方天井院；前堂后寝、内外有别——后院与外院的区隔是宅斗戏的空间语法。", "③"],
      ["家具与陈设", "明式家具（硬木、榫卯、线条）在此期走向巅峰；书房陈设字画、琴棋、香炉；悬「中堂」书画。", "③"],
    ],
  },
  {
    h: "一日作息：十二时辰", items: [
      ["时辰对照", "子23–1 丑1–3 寅3–5 卯5–7 辰7–9 巳9–11 午11–13 未13–15 申15–17 酉17–19 戌19–21 亥21–23。一个时辰=两小时，刻＝14.4分钟（百刻制）。", "①"],
      ["官员的一天", "御门听政在卯正前后（日出前后，凌晨五点多起床赶朝是常调）；衙门放告、签押办公在巳午；写「半夜上朝」是硬伤，「五更趋朝」是史实。", "①②"],
      ["市井的一天", "坊市有宵禁（京城尤严），江南市镇松弛；夜间点灯用油烛，灯油是日常开支——「省油灯」是真话题。", "②③"],
    ],
  },
  {
    h: "节令：全年戏剧日历", items: [
      ["正旦与上元", "正旦（春节）官府朝贺、民间祭祖拜年；上元灯市通宵开禁——京城夜里唯一合法的热闹，灯节戏天然适合邂逅与走失。", "②③"],
      ["清明·端午·中元", "清明祭扫踏青；端午龙舟、悬艾、饮雄黄（白蛇传戏眼）；中元祭鬼——恐怖/温情题材皆宜。", "②③"],
      ["中秋·冬至·除夕", "中秋赏月月饼（明代渐成风俗）；冬至大如年，百官朝贺；除夕守岁、门神春联（贴春联正是明代朱元璋朝起推广的习俗——好用的细节）。", "②③"],
    ],
  },
  {
    h: "行程：路引与速度", items: [
      ["出行的合法性", "军民出百里即需路引（官府签发，注明去向期限），关津查验、客店投宿须验引。无引=逃户/逃军。伪引、借度牒、冒用火牌是灰色通行证。", "①②"],
      ["速度量级（估算参考）", "驿传快马日行约 300 里，军情六百里加急为极限动员；普通客船顺流快、逆流慢，京杭运河全程常以「月」计；步行日行 50–70 里。写「三日从北京赶到南京」需要八百里加急级别的叙事豁免。", "②③④"],
      ["漕运", "漕船北上载粮以月计，运河闸口拥堵、黄河改道风险是常调素材；沿运河城镇（临清、淮安）因漕而兴——写商旅必经的舞台。", "①③"],
    ],
  },
];
---
<BaseLayout title="生活场景库 · 创作者" crumbs={[["/", "首页"], ["/creators", "创作者"], ["", "生活场景库"]]}>
  <div class="wrap" style="max-width:820px">
    <div class="page-head">
      <h1>生活场景库</h1>
      <p class="lede">衣食住行、时辰节令、行程速度——把「人怎么活」写成可信的背景板。每条给年代边界与出处等级。</p>
    </div>
    {SECTIONS.map((sec) => (
      <section style="margin-top:24px">
        <h2 style="font-size:19px;border-bottom:1px solid var(--c-line-soft);padding-bottom:8px">{sec.h}</h2>
        {sec.items.map(([t, d, src]) => (
          <div class="card" style="margin-top:10px;padding:12px 16px">
            <strong style="font-family:var(--font-display)">{t}</strong>
            <div style="font-size:14px;margin-top:4px">{d} <span class={`sb sb${src}`}>{src}</span></div>
          </div>
        ))}
      </section>
    ))}
    <p style="font-size:12px;color:var(--c-ink-2);margin-top:16px">更细的吃穿用度可延伸阅读：陈宝良《明代社会生活史》③；语感范本：《金瓶梅》《三言二拍》②。</p>
  </div>
</BaseLayout>
