---
import BaseLayout from "../../layouts/BaseLayout.astro";
import V3Chart from "../../components/viz/V3Chart.astro";
import { SOURCE_LEVELS } from "../../lib/data.js";
import SourceBadge from "../../components/SourceBadge.astro";
---
<BaseLayout title="权力消长长卷（V3）· 权力" crumbs={[["/", "首页"], ["/power", "权力"], ["", "消长长卷"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>权力消长长卷</h1>
      <p class="lede">276 年里，皇权、阁权、宦权、言官的力量如何此消彼长——一张图看完明代政治的主旋律。</p>
    </div>
    <div class="card" style="padding:16px 12px 8px"><V3Chart /></div>

    <section class="prose" style="margin-top:28px">
      <h2 style="font-size:19px">我们如何绘制这张图（方法声明）</h2>
      <p>四条曲线不是统计数据，而是<strong>叙事示意</strong>：依据学界共识把每个时期的强弱判断转为 0–10 的相对刻度，
      目的是给读者一个「一眼看懂起伏」的心智模型，而非伪精确的量化。<span class="sb sb3">③</span></p>
      <ul style="font-size:14px">
        <li><strong>皇权集中度</strong>：制度性集权全程高位；低谷对应皇帝年幼/辅政/怠政（正统初三杨、万历初张冯李、天启）。</li>
        <li><strong>阁权</strong>：随票拟制度化而兴，1572–1582 张居正时代为唯一高峰；身后清算后永久性回落。</li>
        <li><strong>宦权</strong>：四个波峰＝王振、汪直、刘瑾、魏忠贤——每次登顶后都被皇权瞬间收回，说明其权力来自皇权本身。</li>
        <li><strong>言官/党争</strong>：争国本（1586）后持续走高，晚明政治以党争为轴心直至亡国。</li>
      </ul>
      <p style="font-size:13px;color:var(--c-ink-2)">定性依据：孟森《明史讲义》、王天有《明代国家机构研究》、樊树志《晚明史》的分期判断；黄仁宇《万历十五年》对申时行时期的刻画。</p>
    </section>
  </div>
</BaseLayout>
