---
import BaseLayout from "../../layouts/BaseLayout.astro";
import V2Flow from "../../components/viz/V2Flow.astro";
---
<BaseLayout title="一份奏章的旅程（V2）· 权力" crumbs={[["/", "首页"], ["/power", "权力"], ["", "奏章的旅程"]]}>
  <div class="wrap prose" style="padding-top:24px">
    <h1>一份奏章的旅程</h1>
    <p style="color:var(--c-ink-2)">明代中枢决策的完整流程。点「自动播放」或「下一步」，跟着一份章奏走完全程——谁在哪个环节握有权力，一目了然。</p>
    <V2Flow />
    <p style="font-size:12px;color:var(--c-ink-2)">流程依据：《明史·职官志》①、孙承泽《春明梦余录》②；术语均可回术语表查看（票拟、批红、封驳、留中）。</p>
  </div>
</BaseLayout>
