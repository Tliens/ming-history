---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import EraStrip from "../../../components/EraStrip.astro";
import SourceBadge from "../../../components/SourceBadge.astro";
import { STAGES } from "../../../data/stages.js";
import { events, figuresById, emperorById } from "../../../lib/data.js";

export function getStaticPaths() {
  return STAGES.map((s, i) => ({ params: { id: s.id }, props: { stage: s, idx: i } }));
}
const { stage, idx } = Astro.props;
const evts = stage.events.map((id) => events.events.find((e) => e.id === id)).filter(Boolean);
const figs = stage.figures.map((id) => figuresById[id]).filter(Boolean);
const emp = emperorById(stage.era === "洪熙" ? "hongxi" : { 洪武: "hongwu", 建文: "jianwen", 永乐: "yongle", 宣德: "xuande", 景泰: "jingtai", 弘治: "hongzhi", 嘉靖: "jiajing", 万历: "wanli", 崇祯: "chongzhen" }[stage.era] ?? "hongwu");
const prev = STAGES[idx - 1], next = STAGES[idx + 1];
---
<BaseLayout title={`${stage.title}（${stage.years}）· 权力演变`} crumbs={[["/", "首页"], ["/power", "权力"], ["/power/evolution", "消长长卷"], ["", stage.title]]}>
  <div class="wrap prose" style="padding-top:24px">
    <EraStrip current={stage.era} />
    <p style="font-size:13px;color:var(--c-ink-2);margin-top:10px">阶段 {stage.id.toUpperCase()} · {idx + 1}/9 · <a href="/power/evolution">← 回到消长长卷</a></p>
    <h1 style="margin-bottom:2px">{stage.title}</h1>
    <p style="color:var(--c-ink-2);margin-top:0">{stage.years}</p>

    <div class="tldr">{stage.feature}</div>

    <section>
      <h2 style="font-size:19px">权力得失</h2>
      <ul>
        {stage.shift.map((s) => <li set:html={s} />)}
      </ul>
    </section>

    {evts.length > 0 && (
      <section>
        <h2 style="font-size:19px">本阶段大事（{evts.length}）</h2>
        <ul style="line-height:2">
          {evts.map((e) => <li><a href={`/events/${e.id}`}>{e.year} · {e.title}</a></li>)}
        </ul>
      </section>
    )}

    {figs.length > 0 && (
      <section>
        <h2 style="font-size:19px">本阶段人物</h2>
        <p>{figs.map((f) => <a class="card" href={`/figures/${f.id}`} style="display:inline-block;padding:4px 12px;margin:3px;font-size:14px">{f.name}</a>)}</p>
      </section>
    )}

    <section>
      <h2 style="font-size:19px">承上启下</h2>
      <p>{stage.legacy}</p>
    </section>

    <p style="font-size:12px;color:var(--c-ink-2)">
      分期与判断依据：孟森《明史讲义》、樊树志《明史十讲》、王天有《明代国家机构研究》 <span class="sb sb3">③</span>
      {emp && <> · 当期皇帝：<a href={`/emperors/${emp.id}`}>{emp.templeName}</a></>}
    </p>

    <nav style="display:flex;justify-content:space-between;margin-top:36px;border-top:1px solid var(--c-line);padding-top:16px">
      {prev ? <a href={`/power/stages/${prev.id}`}>← {prev.title}</a> : <span />}
      {next ? <a href={`/power/stages/${next.id}`}>{next.title} →</a> : <span />}
    </nav>
  </div>
</BaseLayout>
