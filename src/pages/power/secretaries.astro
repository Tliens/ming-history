---
// V4 首辅序列与皇帝对位（甘特）· 数据 first-secretaries.json（56 人 / 64 任）
import BaseLayout from "../../layouts/BaseLayout.astro";
import { secretaries } from "../../lib/data.js";
const nTerms = secretaries.secretaries.reduce((n, s) => n + s.terms.length, 0);
---
<BaseLayout title="首辅序列（V4）· 权力" crumbs={[["/", "首页"], ["/power", "权力"], ["", "首辅序列"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>内阁首辅序列</h1>
      <p class="lede">永乐至崇祯 {secretaries.secretaries.length} 位首辅、{nTerms} 任任期，与皇帝在位对位。右侧滑块缩放行区间；点击色条看人物详情。</p>
    </div>
    <div class="card" style="padding:16px 8px">
      <div id="v4chart" style="height:1160px" aria-label="首辅序列甘特图"></div>
    </div>
    <p style="font-size:12px;color:var(--c-ink-2);margin-top:8px">
      数据源：《明史·宰辅年表》①（first-secretaries.json）；年份精确到年，月份与 10 处 uncertain 标记待校对轮补全。金色条＝张居正在位期（1572–1582）；蓝色条＝其余首辅任期。
    </p>
  </div>
</BaseLayout>

<script>
  import * as echarts from "echarts";
  import { MING_THEME, ERAS_BAND } from "../../lib/echarts-theme.js";
  import secretariesData from "../../data/first-secretaries.json";
  const secretaries = secretariesData.secretaries;

  const chart = echarts.init(document.getElementById("v4chart"), MING_THEME);
  const rows = secretaries.map((s) => ({ ...s, first: Math.min(...s.terms.map((t) => t.start)) }))
    .sort((a, b) => a.first - b.first);
  const nRows = rows.length;

  // 皇帝色带（顶行，独立数值轴 y0: -1.2..0）
  const bandSeries = {
    name: "皇帝在位", type: "custom", yAxisIndex: 0,
    renderItem: (params, api) => {
      const e = ERAS_BAND[params.dataIndex];
      const a = api.coord([e[1], -0.045]), b = api.coord([e[2] + 1, 0]);
      return { type: "rect", transition: [], shape: { x: a[0], y: b[1], width: b[0] - a[0], height: a[1] - b[1] }, style: { fill: e[3], opacity: 0.92 } };
    },
    data: ERAS_BAND.map((e) => [e[1], e[2]]),
    encode: { x: [0, 1] }, z: 3, silent: true,
  };
  // 注：色带只占 yAxis[0]（-1.2..0）顶部 -0.16..0 的窄条，下方留给 56 行任期条

  // 首辅任期条（category 行轴 y1，index 定位）
  const termSeries = {
    name: "首辅任期", type: "custom", yAxisIndex: 1,
    renderItem: (params, api) => {
      const row = params.dataIndex;
      const s = api.value(1), e = api.value(2), gold = api.value(3);
      const p1 = api.coord([s, row]), p2 = api.coord([e + 1, row]);
      const h = api.size([0, 1])[1] * 0.6;
      return {
        type: "rect", transition: [],
        shape: { x: p1[0], y: p1[1] - h / 2, width: Math.max(p2[0] - p1[0], 2), height: h },
        style: { fill: gold ? "#C6A664" : "#2E5A88", opacity: gold ? 0.95 : 0.78, stroke: "rgba(247,243,232,.8)", lineWidth: 0.5 },
      };
    },
    data: rows.flatMap((s, i) => s.terms.map((t) => ({ value: [i, t.start, t.end ?? t.start, s.id === "zhang-juzheng" ? 1 : 0] }))),
    encode: { x: [1, 2], y: 0 }, z: 2,
  };

  chart.setOption({
    animation: false,
    grid: { left: 100, right: 44, top: 30, bottom: 20 },
    xAxis: { type: "value", min: 1402, max: 1645, splitLine: { lineStyle: { color: "rgba(138,109,59,.12)" } }, axisLabel: { fontSize: 11, color: "#5C5346" } },
    yAxis: [
      { type: "value", min: -1.2, max: 0, show: false },
      { type: "category", data: rows.map((s) => s.name), inverse: true,
        axisLabel: { fontSize: 11, color: "#2B2620" }, axisTick: { show: false }, axisLine: { show: false }, splitLine: { show: false } },
    ],
    dataZoom: [
      { type: "slider", yAxisIndex: [1], right: 6, width: 20, start: 0, end: 100, labelFormatter: (i) => rows[i]?.name ?? "" },
      { type: "inside", yAxisIndex: [1], zoomOnMouseWheel: false, moveOnMouseWheel: true },
    ],
    tooltip: {
      formatter: (p) => {
        if (p.seriesName === "皇帝在位") { const e = ERAS_BAND[p.dataIndex]; return `<b>${e[0]}</b>（${e[1]}–${e[2]}）`; }
        const row = rows[p.value[0]];
        return `<b>${row.name}</b>（${row.terms.map((t) => t.start + "–" + (t.end ?? t.start)).join("；")}）<br/><span style="color:#5C5346;font-size:12px">${row.origin ?? ""} · ${row.jinshi ? row.jinshi + " 年进士" : (row.jinshiNote ?? "")}</span><br/><span style="font-size:12px">${row.note ?? ""}</span><br/><span style="font-size:12px;color:#9E5B3C">结局：${row.fate ?? ""}</span>`;
      },
    },
    series: [bandSeries, termSeries],
  });

  chart.on("click", (p) => {
    if (p.seriesName === "首辅任期") {
      const s = rows[p.value[0]];
      alert(`${s.name}\n${s.note ?? ""}\n\n结局：${s.fate ?? ""}`);
    }
  });
  window.addEventListener("resize", () => chart.resize());
</script>
