---
import BaseLayout from "../../layouts/BaseLayout.astro";
import V1Chart from "../../components/viz/V1Chart.astro";
---
<BaseLayout title="制度解剖（V1）· 权力" crumbs={[["/", "首页"], ["/power", "权力"], ["", "制度解剖"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>制度解剖：四期组织结构图</h1>
      <p class="lede">切换洪武 / 永宣 / 正德 / 万历四个代表时期，看权力机器的搭建、增补与异化。红色＝该期新设/复设节点，灰色＝该期不存在的节点。</p>
    </div>
    <div class="card" style="padding:16px 12px"><V1Chart /></div>
    <p style="font-size:12px;color:var(--c-ink-2);margin-top:8px">
      节点点击显示机构词条（品级/职掌/设立年份）。数据源：《明史·职官志》①、《大明会典》①、王天有《明代国家机构研究》③（offices.json）。
    </p>
  </div>
</BaseLayout>
