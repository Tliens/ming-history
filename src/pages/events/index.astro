---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EraStrip from "../../components/EraStrip.astro";
import V6Chart from "../../components/viz/V6Chart.astro";
import { events, eraOf, ERAS } from "../../lib/data.js";
const sorted = [...events.events].sort((a, b) => a.year - b.year);

// 按朝代分组（十七年号段），给长列表节奏
const GROUPS = [];
for (const ev of sorted) {
  const { era } = eraOf(ev.year);
  const last = GROUPS[GROUPS.length - 1];
  if (!last || last.name !== era.name) {
    const meta = ERAS.find((e) => e.name === era.name);
    GROUPS.push({ name: era.name, color: meta?.color ?? "#8A6D3B", span: meta ? `${meta.start}–${meta.end}` : "", items: [] });
  }
  GROUPS[GROUPS.length - 1].items.push(ev);
}
---
<BaseLayout title="大事年表" crumbs={[["/", "首页"], ["", "大事"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>大事年表</h1>
      <p class="lede">骨干大事 {events.events.length} 条，覆盖九个阶段至南明。每条含起因—经过—结果—影响四段与分级出处。</p>
    </div>
    <EraStrip />
    <div class="card" style="padding:16px 12px 8px;margin:20px 0"><V6Chart /></div>

    {GROUPS.map((g) => (
      <section style="margin-top:26px">
        <h2 style="display:flex;align-items:center;gap:10px;font-size:16px;margin:0 0 10px;position:sticky;top:64px;background:var(--c-paper);padding:6px 0;z-index:10">
          <span class="era-dot" style={`background:${g.color}`}></span>
          <span style="font-family:var(--font-display)">{g.name}</span>
          <span style="font-size:12px;color:var(--c-ink-2);font-weight:400">{g.span} · {g.items.length} 条</span>
        </h2>
        <div style="display:grid;gap:8px">
          {g.items.map((ev) => {
            const { text } = eraOf(ev.year);
            return (
              <a class="ev-row" href={`/events/${ev.id}`}>
                <strong style="font-family:var(--font-display);font-size:16px;min-width:52px">{ev.year}</strong>
                <span style="font-size:12px;color:var(--c-ink-2);min-width:76px">{text}</span>
                <strong style="font-weight:600">{ev.title}</strong>
                <span style="margin-left:auto;font-size:11px;color:var(--c-ink-2)">{ev.layers.join(" · ")}</span>
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
<style>
  .ev-row { display: flex; gap: 14px; align-items: baseline; padding: 10px 14px; border-radius: var(--r-s);
    background: var(--c-surface); border: 1px solid var(--c-line-soft); color: var(--c-ink); transition: all 0.13s; }
  .ev-row:hover { background: var(--c-th-bg); border-color: var(--c-line); text-decoration: none; }
  .era-dot { width: 10px; height: 10px; border-radius: 50%; flex: none; background-color: #8A6D3B; }
</style>
