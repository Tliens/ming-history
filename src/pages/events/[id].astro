---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InfoBox from "../../components/InfoBox.astro";
import SourceBadge from "../../components/SourceBadge.astro";
import { events, figureByAnyName, consortByAnyName } from "../../lib/data.js";

export function getStaticPaths() {
  return events.events.map((ev) => ({ params: { id: ev.id }, props: { ev } }));
}
const { ev } = Astro.props;
const figs = (ev.figures || [])
  .map((n) => {
    const f = figureByAnyName(n);
    if (f) return { href: `/figures/${f.id}`, label: n };
    const c = consortByAnyName(n);
    if (c) return { href: `/harem/consorts/${c.id}`, label: c.name };
    return null;
  })
  .filter(Boolean);
const sections = [["起因", ev.cause], ["经过", ev.process], ["结果", ev.result], ["影响", ev.impact]];
---
<BaseLayout title={`${ev.title}（${ev.year}）· 大事`} crumbs={[["/", "首页"], ["/events", "大事"], ["", ev.title]]}>
  <div class="wrap prose" style="padding-top:24px">
    <h1 style="margin-bottom:4px">{ev.title}</h1>
    <p style="color:var(--c-ink-2)">{ev.dateLabel} · {ev.layers.join(" / ")}
      {ev.location?.name && <> · 地点：{ev.location.name}（今{ev.location.now}）</>}
    </p>

    {sections.map(([h, t]) => t && (<section><h2 style="font-size:19px">{h}</h2><p>{t}</p></section>))}

    {ev.misconceptions && <InfoBox kind="myth" items={ev.misconceptions.map((m) => m)} />}

    {figs.length > 0 && (
      <section>
        <h2 style="font-size:19px">相关人物</h2>
        <p>{figs.map((f) => <a href={f.href} style="margin-right:12px">{f.label}</a>)}</p>
      </section>
    )}

    <section>
      <h2 style="font-size:19px">出处</h2>
      <ul style="font-size:14px">
        {ev.sources.map((s) => <li><SourceBadge level={s.level} /> {s.text}</li>)}
      </ul>
    </section>

    {ev.maps && (
      <p><a href="/maps/empire">→ 在疆域地图上查看相关地理（{ev.maps.join("、")}）</a></p>
    )}
  </div>
</BaseLayout>
