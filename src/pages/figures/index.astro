---
import BaseLayout from "../../layouts/BaseLayout.astro";
import EraStrip from "../../components/EraStrip.astro";
import { figures } from "../../lib/data.js";
const CATS = ["文臣", "武将", "武将（文官出镇）", "思想·武将", "宦官", "文宗", "文士", "科学家", "科学家·文臣", "对立阵营"];
const byCat = (c) => figures.figures.filter((f) => f.category === c);
---
<BaseLayout title="名臣将领 · 人物" crumbs={[["/", "首页"], ["", "人物"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>名臣将领</h1>
      <p class="lede">首批 {figures.figures.length} 人（正史立传者为主干）。结局分类可按「善终/被害/殉国/身后清算」筛选（Phase 3 加筛选器）。</p>
    </div>
    <EraStrip />
    <p style="margin-top:10px"><a class="card" href="/figures/network" style="display:inline-block;padding:6px 16px;font-size:14px">🕸 人物关系网络图（V14）→</a></p>
    {CATS.filter((c) => byCat(c).length > 0).map((c) => (
      <section style="margin-top:28px">
        <h2 style="font-size:19px;border-bottom:1px solid var(--c-line);padding-bottom:6px">{c}（{byCat(c).length}）</h2>
        <div class="grid" style="margin-top:12px">
          {byCat(c).map((f) => (
            <a class="card" href={`/figures/${f.id}`}>
              <strong style="font-family:var(--font-display);font-size:16px">{f.name}</strong>
              {f.zi && <span style="font-size:12px;color:var(--c-ink-2)">（{f.zi}）</span>}
              <div style="font-size:12px;color:var(--c-ink-2)">{f.birth ?? "?"}–{f.death ?? "?"} · {f.career?.split("→").at(-1)}</div>
              <div style="font-size:13px;margin-top:6px">{f.deeds?.slice(0, 42)}…</div>
              <div style="font-size:11px;margin-top:6px;color:var(--c-ink-2)">结局：{f.fateType}</div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
