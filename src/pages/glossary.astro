---
import BaseLayout from "../layouts/BaseLayout.astro";
import { glossary } from "../lib/data.js";
const cats = [...new Set(glossary.terms.map((t) => t.cat))];
---
<BaseLayout title="术语表" crumbs={[["/", "首页"], ["", "术语表"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>术语表（{glossary.terms.length} 条）</h1>
      <p class="lede">全站正文术语弹窗的数据源。输入即时过滤；点击分类标签跳转。</p>
    </div>
    <input id="gq" type="search" placeholder="搜索术语…（如：票拟、卫所、京察）"
      style="width:100%;max-width:420px;padding:10px 14px;border:1px solid var(--c-line);border-radius:8px;font-size:15px" />
    <div id="gcat" style="margin:14px 0">
      {cats.map((c) => <button class="gcat-btn" data-cat={c} style="border:1px solid var(--c-line);background:none;border-radius:14px;padding:3px 12px;font-size:13px;margin:2px;cursor:pointer">{c}</button>)}
      <button class="gcat-btn" data-cat="" style="border:1px solid var(--c-vermilion);color:var(--c-vermilion);background:none;border-radius:14px;padding:3px 12px;font-size:13px;margin:2px;cursor:pointer">全部</button>
    </div>
    <dl id="glist" style="max-width:760px">
      {glossary.terms.map((t) => (
        <div class="gitem" data-cat={t.cat} data-term={t.term} id={t.id} style="padding:10px 0;border-bottom:1px dashed var(--c-line)">
          <dt style="font-family:var(--font-display);font-size:17px;font-weight:600">{t.term}
            <span style="font-size:11px;color:var(--c-paper);background:var(--c-zhehuang);border-radius:3px;padding:1px 6px;vertical-align:2px;margin-left:6px">{t.cat}</span></dt>
          <dd style="margin:4px 0 0;font-size:14px">{t.def}</dd>
          {t.related && t.related.length > 0 && (
            <dd style="margin:2px 0 0;font-size:12px;color:var(--c-ink-2)">相关：
              {t.related.map((r) => { const rt = glossary.terms.find((x) => x.id === r); return rt ? <a href={`#${r}`}>{rt.term}</a> : null; })}
            </dd>
          )}
        </div>
      ))}
    </dl>
    <p id="gempty" style="display:none;color:var(--c-ink-2)">无匹配术语。</p>
  </div>
  <script>
    const q = document.getElementById("gq");
    const items = [...document.querySelectorAll(".gitem")];
    let cat = "";
    const apply = () => {
      const kw = q.value.trim();
      let n = 0;
      for (const el of items) {
        const ok = (!cat || el.dataset.cat === cat) && (!kw || el.dataset.term.includes(kw) || el.textContent.includes(kw));
        el.style.display = ok ? "" : "none"; if (ok) n++;
      }
      document.getElementById("gempty").style.display = n ? "none" : "";
    };
    q.addEventListener("input", apply);
    document.querySelectorAll(".gcat-btn").forEach((b) => b.addEventListener("click", () => { cat = b.dataset.cat; apply(); }));
  </script>
</BaseLayout>
