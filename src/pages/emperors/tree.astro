---
// V5 帝王世系树 + 在位甘特（emperors.json 数据 + 帝位传承关系图）
import BaseLayout from "../../layouts/BaseLayout.astro";
import { emperors, ERAS } from "../../lib/data.js";
---
<BaseLayout title="世系树与在位时间轴（V5）· 皇帝" crumbs={[["/", "首页"], ["/emperors", "皇帝"], ["", "世系树"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>世系树与在位时间轴</h1>
      <p class="lede">帝位传承的血脉主线（仅列帝系，非完整皇族谱）：红色虚线标记四次非正常传位。点击节点进入皇帝页。</p>
    </div>
    <div class="card" style="padding:12px"><div id="v5tree" style="height:760px" class="chart-wrap"><div class="chart-skel"></div></div></div>
    <div class="card" style="padding:12px;margin-top:16px"><div id="v5gantt" style="height:420px" class="chart-wrap"><div class="chart-skel"></div></div></div>
    <p style="font-size:12px;color:var(--c-ink-2);margin-top:8px">
      非正常传位四例：靖难（太祖系内夺位）· 夺门（兄弟复辟）· 兄终弟及（熹宗→思宗）· 外藩入继（兴献王系）。数据源：emperors.json + 《明史·诸王世表》①。
    </p>
  </div>
</BaseLayout>

<script>
  import * as echarts from "echarts";
  import { chartTheme, onThemeChange, ERAS_BAND } from "../../lib/echarts-theme.js";

  // 帝系传承：id, 简名, 传承方式
  const E = {
    hongwu: { n: "太祖\n洪武", c: "#A02C2C" }, jianwen: { n: "惠宗\n建文", c: "#8A6D3B" },
    yongle: { n: "成祖\n永乐", c: "#8A6D3B" }, hongxi: { n: "仁宗\n洪熙", c: "#C6A664" },
    xuande: { n: "宣宗\n宣德", c: "#C6A664" }, yingzong: { n: "英宗\n正统/天顺", c: "#9E5B3C" },
    jingtai: { n: "代宗\n景泰", c: "#9E5B3C" }, chenghua: { n: "宪宗\n成化", c: "#3E7C59" },
    hongzhi: { n: "孝宗\n弘治", c: "#3E7C59" }, zhengde: { n: "武宗\n正德", c: "#5A4A6E" },
    jiajing: { n: "世宗\n嘉靖", c: "#5A4A6E" }, longqing: { n: "穆宗\n隆庆", c: "#2E5A88" },
    wanli: { n: "神宗\n万历", c: "#2E5A88" }, taichang: { n: "光宗\n泰昌", c: "#2B2620" },
    tianqi: { n: "熹宗\n天启", c: "#2B2620" }, chongzhen: { n: "思宗\n崇祯", c: "#2B2620" },
  };
  const node = (id, link, extra = {}) => ({ name: E[id].n, id, itemStyle: { color: E[id].c, borderColor: "rgba(43,38,32,.35)" }, link, ...extra });
  const TREE = node("hongwu", "/emperors/hongwu", { children: [
    node("jianwen", "/emperors/jianwen"), // 懿文太子系
    node("yongle", "/emperors/yongle", { lineStyle: { type: [5, 4], color: "#A02C2C", width: 2.5 }, children: [
      node("hongxi", "/emperors/hongxi", { children: [ node("xuande", "/emperors/xuande", { children: [
        node("yingzong", "/emperors/yingzong", { children: [ node("chenghua", "/emperors/chenghua", { children: [ node("hongzhi", "/emperors/hongzhi", { children: [ node("zhengde", "/emperors/zhengde") ] }) ] }) ] }),
        node("jingtai", "/emperors/jingtai", { lineStyle: { type: [3, 3], color: "#9E5B3C" } }),
      ] }) ] }),
    ] }),
  ] });
  // 世宗一支（兴献王系）挂回宪宗之下
  TREE.children[1].children[0].children[0].children[0].children.push(
    node("jiajing", "/emperors/jiajing", { lineStyle: { type: [5, 4], color: "#5A4A6E", width: 2.5 }, children: [
      node("longqing", "/emperors/longqing", { children: [ node("wanli", "/emperors/wanli", { children: [ node("taichang", "/emperors/taichang", { children: [
        node("tianqi", "/emperors/tianqi"), node("chongzhen", "/emperors/chongzhen", { lineStyle: { type: [3, 3], color: "#2B2620" } }),
      ] }) ] }) ] }),
    ] })
  );

  const treeEl = document.getElementById("v5tree");
  const ganttEl = document.getElementById("v5gantt");
  let tree = echarts.init(treeEl, chartTheme());
  function treeOption() {
    return {
      series: [{
        type: "tree", data: [TREE], orient: "LR", roam: true,
        top: "4%", bottom: "4%", left: "6%", right: "14%",
        symbol: "circle", symbolSize: 30, expandAndCollapse: false, initialTreeDepth: -1,
        label: { position: "top", distance: 6, fontSize: 11, lineHeight: 14, color: chartTheme().ink, align: "center" },
        leaves: { label: { position: "right" } },
        lineStyle: { color: chartTheme().axis, width: 1.6, curveness: 0.5 },
        emphasis: { focus: "descendant" },
      }],
      tooltip: { show: false },
    };
  }
  function bindTree() { tree.on("click", (p) => { if (p.data?.link) location.href = p.data.link; }); }
  tree.setOption(treeOption()); bindTree();
  treeEl.querySelector('.chart-skel')?.remove();

  // 在位甘特：单列 x=年份
  import emperorsData from "../../data/emperors/emperors.json";
  const EMPERORS = emperorsData.emperors;
  const COLOR = Object.fromEntries(ERAS_BAND.map((e) => [e[4], e[3]]));
  let gantt = echarts.init(ganttEl, chartTheme());
  function ganttOption() {
    const t = chartTheme();
    return {
      grid: { left: 90, right: 30, top: 16, bottom: 34 },
      xAxis: { type: "value", min: 1366, max: 1646, axisLabel: { fontSize: 11, color: t.sub }, splitLine: { lineStyle: { color: t.split } } },
      yAxis: { type: "category", inverse: true, data: EMPERORS.map((e) => e.templeName + "·" + e.name), axisLabel: { fontSize: 11, color: t.ink }, axisTick: { show: false }, axisLine: { show: false } },
      tooltip: { ...t.tooltip, formatter: (p) => { const e = EMPERORS[p.dataIndex]; return `<b>${e.templeName} ${e.name}</b>（${e.reignStart}–${e.reignEnd}）<br/><span style="font-size:12px">${e.era}${e.eras ? "／" + e.eras.map((x) => x.era).join("、") : ""}</span>`; } },
      series: [{
        type: "custom", renderItem: (params, api) => {
          const emp = EMPERORS[params.dataIndex];
          const a = api.coord([emp.reignStart, params.dataIndex]), b = api.coord([emp.reignEnd + 1, params.dataIndex]);
          const h = api.size([0, 1])[1] * 0.62;
          return { type: "rect", transition: [], shape: { x: a[0], y: a[1] - h / 2, width: b[0] - a[0], height: h },
            style: { fill: COLOR[emp.id] ?? "#2E5A88", opacity: 0.85, stroke: "rgba(247,243,232,.5)", lineWidth: 0.5 } };
        },
        data: EMPERORS.map((e) => 1), encode: { x: [0, 1], y: 0 },
      }],
    };
  }
  function bindGantt() { gantt.on("click", (p) => { location.href = `/emperors/${EMPERORS[p.dataIndex].id}`; }); }
  gantt.setOption(ganttOption()); bindGantt();
  ganttEl.querySelector('.chart-skel')?.remove();
  function rerender() {
    tree.dispose(); tree = echarts.init(treeEl, chartTheme()); tree.setOption(treeOption()); bindTree();
  treeEl.querySelector('.chart-skel')?.remove();
    gantt.dispose(); gantt = echarts.init(ganttEl, chartTheme()); gantt.setOption(ganttOption()); bindGantt();
  ganttEl.querySelector('.chart-skel')?.remove();
  }
  onThemeChange(rerender);
  window.addEventListener("resize", () => { tree.resize(); gantt.resize(); });
</script>
