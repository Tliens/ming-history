---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import InfoBox from "../../../components/InfoBox.astro";
import { consorts } from "../../../lib/data.js";

export function getStaticPaths() {
  return consorts.consorts.map((c) => ({ params: { id: c.id }, props: { c } }));
}
const { c } = Astro.props;
---
<BaseLayout title={`${c.name} · 后宫`} crumbs={[["/", "首页"], ["/harem", "后宫"], ["", c.name]]}>
  <div class="wrap prose" style="padding-top:24px">
    <h1 style="margin-bottom:2px">{c.name}</h1>
    <p style="color:var(--c-ink-2)">{c.origin} · {c.birth ?? "生年不详"}–{c.death ?? "卒年不详"}</p>

    <section><h2 style="font-size:19px">其人其事</h2><p>{c.story}</p></section>
    <section><h2 style="font-size:19px">结局</h2><p>{c.fate}</p></section>

    <div class="tldr"><strong>评断：</strong>{c.evaluation}</div>

    {c.creativeHook && (
      <section>
        <h2 style="font-size:19px">创作者视角</h2>
        <p style="font-size:14px;border-left:3px solid var(--c-zhehuang);padding-left:12px">{c.creativeHook}</p>
      </section>
    )}

    {c.disputed && <InfoBox kind="disputed" title="考据 · 存疑之处" items={c.disputed.map((d) => `${d}——诸说并列，详见考据笔记 <span class='sb sb3'>③</span>`)} />}

    <p style="font-size:12px;color:var(--c-ink-2)">出处：{c.sources.map((s) => s.text).join("；")}</p>
    <p><a href="/harem">← 回后宫总览</a></p>
  </div>
</BaseLayout>
