---
import BaseLayout from "../../layouts/BaseLayout.astro";
import InfoBox from "../../components/InfoBox.astro";
import { consorts } from "../../lib/data.js";
const rs = consorts.rankSystem;
---
<BaseLayout title="后宫与外戚" crumbs={[["/", "首页"], ["", "后宫"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>后宫与外戚</h1>
      <p class="lede">皇权的暗面与镜面：明代后宫如何运作、为何基本无外戚之祸、哪些女性真正触碰过权力。</p>
    </div>

    <section style="margin:24px 0">
      <h2 style="font-size:20px;border-bottom:1px solid var(--c-line);padding-bottom:8px">位号体系（V16 数据）</h2>
      <table class="data" style="max-width:680px;margin-top:12px">
        {rs.levels.map((l) => (
          <tr><td style="width:36px;font-family:var(--font-display);font-weight:700">{l.level}</td><td style="width:150px"><strong>{l.title}</strong></td><td style="font-size:13px;color:var(--c-ink-2)">{l.note}</td></tr>
        ))}
      </table>
      <p style="font-size:12px;color:var(--c-ink-2);margin-top:6px">依据《大明会典》①与《明史·后妃传》①；「皇贵妃」号源流见下方考据。</p>
    </section>

    <section style="margin:24px 0">
      <h2 style="font-size:20px;border-bottom:1px solid var(--c-line);padding-bottom:8px">运作制度</h2>
      <div class="grid" style="margin-top:12px">
        {rs.institutions.map((it) => (
          <div class="card"><strong>{it.name}</strong><p style="margin:6px 0 0;font-size:13px;color:var(--c-ink-2)">{it.note}</p></div>
        ))}
        <div class="card"><strong>选婚：选淑女于民间</strong><p style="margin:6px 0 0;font-size:13px;color:var(--c-ink-2)">{rs.selection}</p></div>
      </div>
    </section>

    <section style="margin:24px 0">
      <h2 style="font-size:20px;border-bottom:1px solid var(--c-line);padding-bottom:8px">后妃人物卡（{consorts.consorts.length}）</h2>
      <div class="grid" style="margin-top:12px">
        {consorts.consorts.map((c) => (
          <a class="card" href={`/harem/consorts/${c.id}`}>
            <strong style="font-family:var(--font-display);font-size:16px">{c.name}</strong>
            <div style="font-size:12px;color:var(--c-ink-2)">{c.emperor} 朝 · {c.birth ?? "?"}–{c.death ?? "?"}</div>
            <div style="font-size:13px;margin-top:6px">{c.story.slice(0, 44)}…</div>
            {c.disputed && <div style="font-size:11px;color:var(--c-disputed,#B3541E);margin-top:4px">存疑：{c.disputed.join("、")}</div>}
          </a>
        ))}
      </div>
    </section>

    <section style="margin:24px 0">
      <h2 style="font-size:20px;border-bottom:1px solid var(--c-line);padding-bottom:8px">专题</h2>
      <ul style="line-height:2.2;margin-top:8px">
        {consorts.themes.map((t) => <li><strong>{t.title}</strong>——{t.note.slice(0, 80)}…<span style="font-size:12px;color:var(--c-ink-2)">（详情随 M3 扩写上线）</span></li>)}
      </ul>
      <InfoBox kind="disputed" title="考据 · 皇贵妃号的首封" items={["《明史·后妃传》序次显示「皇贵妃」号首见于景泰帝封唐氏；成化万氏、万历郑氏为最著者 <span class='sb sb1'>①</span>"]} />
    </section>
  </div>
</BaseLayout>
