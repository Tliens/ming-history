---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { TOPICS } from "../../data/topics.js";
---
<BaseLayout title="专题" crumbs={[["/", "首页"], ["", "专题"]]}>
  <div class="wrap">
    <div class="page-head">
      <h1>深度专题</h1>
      <p class="lede">跨模块的机制分析：把散在人物、事件、图表里的线索，串成因果链。</p>
    </div>
    <div class="grid" style="margin-top:20px">
      {TOPICS.map((t) => (
        <a class="card" href={`/topics/${t.id}`}>
          <h3 style="margin:0 0 6px;font-size:17px">{t.title}</h3>
          <p style="margin:0;font-size:13px;color:var(--c-ink-2)">{t.lede}</p>
        </a>
      ))}
      <a class="card" href="/topics/jiashen" style="border-left:3px solid var(--c-vermilion)">
        <h3 style="margin:0 0 6px;font-size:17px">甲申之变倒计时</h3>
        <p style="margin:0;font-size:13px;color:var(--c-ink-2)">1644 年正月至五月逐日叙事：两个「朝」的开局、两个政权的收场。创作素材金矿。</p>
      </a>
    </div>
  </div>
</BaseLayout>
