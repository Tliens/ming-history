---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { JIASHEN_DAYS } from "../../data/jiashen-days.js";
const FIRST = JIASHEN_DAYS[0], LAST = JIASHEN_DAYS[JIASHEN_DAYS.length - 1];
---
<BaseLayout title="甲申之变倒计时 · 专题" crumbs={[["/", "首页"], ["/topics", "专题"], ["", "甲申倒计时"]]}>
  <div class="wrap" style="max-width:820px">
    <div class="page-head">
      <h1>甲申之变倒计时</h1>
      <p class="lede">崇祯十七年正月到五月（1644.2–6），从一个王朝的两面开场，到两个政权的各自收场——逐日看一座城、一个皇帝、一个时代怎么走到尽头。</p>
    </div>

    <div class="tldr">
      大顺的军队两月推进一千二百里，明朝的朝廷争论南迁两个月；城破前十日才调动的援军在时间上从未存在过。
      <strong>甲申之变不是猝死，是被自己的决策机制一寸寸放血的过程。</strong>①③
    </div>

    <div style="position:relative;margin:28px 0;border-left:3px solid var(--c-vermilion);padding-left:22px">
      {JIASHEN_DAYS.map((day) => (
        <article style="position:relative;margin-bottom:30px" id={`d-${day.d}`}>
          <span style="position:absolute;left:-31px;top:6px;width:13px;height:13px;border-radius:50%;background:var(--c-vermilion);border:3px solid var(--c-paper);box-shadow:0 0 0 1px rgba(160,44,44,.4)"></span>
          <div style="display:flex;gap:12px;align-items:baseline;flex-wrap:wrap">
            <strong style="font-family:var(--font-display);font-size:21px">{day.d}</strong>
            <span style="font-size:12px;color:var(--c-ink-2)">{day.g}</span>
            <strong style="font-size:15px">{day.t}</strong>
          </div>
          <p style="margin:8px 0 6px">{day.body}</p>
          <div style="font-size:13px;color:var(--c-ink-2);border-left:2px solid var(--c-zhehuang);padding-left:10px">
            ✍ 创作视角：{day.hook}
          </div>
          <div style="font-size:11px;color:var(--c-ink-2);margin-top:4px">史料等级 {day.src}</div>
        </article>
      ))}
    </div>

    <section>
      <h2 style="font-size:19px">复盘的三条线索</h2>
      <ul style="font-size:14px">
        <li><strong>财政线</strong>：欠饷→哗变→弃地→两线失血——三月十七「捐银助饷」的闹剧是二十年财政史的缩影。</li>
        <li><strong>决策线</strong>：南迁议而不决、勤王调而不至、责任人人回避——「不上朝≠不管事」的镜像：这次皇帝勤政了，臣僚机制却已空转。</li>
        <li><strong>信息线</strong>：边报与实况脱节（宣府「尚在坚守」时已降）、遗诏文本诸本不一——史料批判的正沿。</li>
      </ul>
      <p style="font-size:13px;color:var(--c-ink-2)">依据：《明史·庄烈帝本纪》《流贼传》①；谈迁《国榷》②；顾诚《明末农民战争史》《南明史》③。诸说并存处（曹化淳开门、吴三桂缘由、遗诏文字）已在正文标注。</p>
    </section>

    <section>
      <h2 style="font-size:19px">课堂问题组（教师用）</h2>
      <ol style="font-size:14px;line-height:1.9">
        <li>【材料】「南迁之议」拖了两个月没有结果。用页面材料说明：每个人「都对」，为什么合起来是死局？责任在谁？可以只怪崇祯吗？</li>
        <li>【讨论】三月十八夜崇祯先送走三个儿子、再逼杀后妃——这套安排说明他当时对局势还有怎样的判断？与随后自缢是否矛盾？</li>
        <li>【分析】页文说「追赃助饷是理解大顺速亡的钥匙」。结合三月十九「紫禁城的接管」一段，解释这句话。</li>
        <li>【史料】崇祯遗诏文字「诸本不一」——选页面任一说法，讨论：为什么一份遗诏会有多个版本？这对我们使用史料有什么提醒？</li>
        <li>【写作】以三月十九日凌晨为场景，从守城士兵、宫女或言官中任选一人视角写 400 字日记（史实不得违背页面材料）。</li>
      </ol>
    </section>

    <p><a href="/events/jiashen-1644">事件主条目：甲申之变 →</a> · <a href="/topics">← 回专题目录</a></p>
  </div>
</BaseLayout>
