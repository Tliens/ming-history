---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourceBadge from "../../components/SourceBadge.astro";
import { TOPICS } from "../../data/topics.js";
import { TOPIC_QUESTIONS } from "../../data/topic-questions.js";
import { events, glossary } from "../../lib/data.js";

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { id: t.id }, props: { topic: t } }));
}
const { topic } = Astro.props;
const qs = TOPIC_QUESTIONS[topic.id] ?? [];
const evts = topic.related.events.map((id) => events.events.find((e) => e.id === id)).filter(Boolean);
const terms = topic.related.terms.map((id) => glossary.terms.find((t) => t.id === id)).filter(Boolean);
---
<BaseLayout title={`${topic.title} · 专题`} crumbs={[["/", "首页"], ["/topics", "专题"], ["", topic.title]]}>
  <div class="wrap" style="padding-top:24px;display:grid;grid-template-columns:minmax(0,1fr) 230px;gap:36px;align-items:start">
  <div class="prose" style="max-width:720px">
    <h1 style="margin-bottom:4px">{topic.title}</h1>
    <p style="color:var(--c-ink-2);margin-top:0">{topic.lede}</p>

    {topic.sections.map(([h, p], i) => (
      <section id={`s-${i}`}><h2 style="font-size:19px">{h}</h2><p>{p}</p></section>
    ))}

    {qs && (
      <section>
        <h2 style="font-size:19px">课堂问题组（教师用）</h2>
        <ol style="font-size:14px;line-height:1.9">
          {qs.map((q) => <li>{q}</li>)}
        </ol>
        <p style="font-size:12px;color:var(--c-ink-2)">【讨论】课堂口头 ·【材料】结合本页材料作答 ·【辩论】分组 ·【写作】课后小论文。配套教材对照见 <a href="/learn/textbook">教材映射页</a>。</p>
      </section>
    )}

    <section>
      <h2 style="font-size:19px">延伸阅读</h2>
      {evts.length > 0 && (
        <p style="font-size:14px">相关事件：{evts.map((e) => <a href={`/events/${e.id}`} style="margin-right:12px">{e.title}</a>)}</p>
      )}
      {terms.length > 0 && (
        <p style="font-size:14px">关键术语：{terms.map((t) => <a href={`/glossary#${t.id}`} style="margin-right:12px">{t.term}</a>)}</p>
      )}
      {topic.related.stages && (
        <p style="font-size:14px">相关阶段：{topic.related.stages.map((s) => <a href={`/power/stages/${s}`} style="margin-right:12px">{s.toUpperCase()}</a>)}</p>
      )}
    </section>

    <p style="font-size:12px;color:var(--c-ink-2)">{topic.sources}</p>
    <p><a href="/topics">← 回专题目录</a></p>
  </div>
  <aside style="position:sticky;top:84px;font-size:13px">
    <div style="font-size:12px;letter-spacing:.1em;color:var(--c-ink-2);margin-bottom:8px">目 录</div>
    {topic.sections.map(([h], i) => (
      <a href={`#s-${i}`} style="display:block;padding:5px 0;border-left:2px solid var(--c-line-soft);padding-left:10px;color:var(--c-ink-2)">{h}</a>
    ))}
    <a href="/learn/textbook" style="display:block;padding:5px 0;border-left:2px solid var(--c-line-soft);padding-left:10px;margin-top:8px">🎓 教材映射</a>
    <a href="/creators/year-dossier" style="display:block;padding:5px 0;border-left:2px solid var(--c-line-soft);padding-left:10px">🗓 年份档案</a>
  </aside>
</div>
</BaseLayout>
