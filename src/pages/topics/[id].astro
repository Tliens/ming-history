---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SourceBadge from "../../components/SourceBadge.astro";
import { TOPICS } from "../../data/topics.js";
import { events, glossary } from "../../lib/data.js";

export function getStaticPaths() {
  return TOPICS.map((t) => ({ params: { id: t.id }, props: { topic: t } }));
}
const { topic } = Astro.props;
const evts = topic.related.events.map((id) => events.events.find((e) => e.id === id)).filter(Boolean);
const terms = topic.related.terms.map((id) => glossary.terms.find((t) => t.id === id)).filter(Boolean);
---
<BaseLayout title={`${topic.title} · 专题`} crumbs={[["/", "首页"], ["/topics", "专题"], ["", topic.title]]}>
  <div class="wrap prose" style="padding-top:24px">
    <h1 style="margin-bottom:4px">{topic.title}</h1>
    <p style="color:var(--c-ink-2);margin-top:0">{topic.lede}</p>

    {topic.sections.map(([h, p]) => (
      <section><h2 style="font-size:19px">{h}</h2><p>{p}</p></section>
    ))}

    <section>
      <h2 style="font-size:19px">延伸阅读</h2>
      {evts.length > 0 && (
        <p style="font-size:14px">相关事件：{evts.map((e) => <a href={`/events/${e.id}`} style="margin-right:12px">{e.title}</a>)}</p>
      )}
      {terms.length > 0 && (
        <p style="font-size:14px">关键术语：{terms.map((t) => <a href={`/glossary#${t.id}`} style="margin-right:12px">{t.term}</a>)}</p>
      )}
      {topic.related.stages && (
        <p style="font-size:14px">相关阶段：{topic.related.stages.map((s) => <a href={`/power/stages/${s}`} style="margin-right:12px">{s.toUpperCase()}</a>)}</p>
      )}
    </section>

    <p style="font-size:12px;color:var(--c-ink-2)">{topic.sources}</p>
    <p><a href="/topics">← 回专题目录</a></p>
  </div>
</BaseLayout>
